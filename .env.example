SHARE_BASE_URL=https://share.transcryb.app

# YouTube video resolution (RapidAPI Social Download All In One)
RAPIDAPI_KEY=...
# RAPIDAPI_HOST=social-download-all-in-one.p.rapidapi.com

# Other platforms (TikTok, Instagram, Facebook, X)
COBALT_API_URL=https://cobalt-production-7dd4.up.railway.app/
# COBALT_API_KEY=...   # only if your Cobalt instance requires auth
# COBALT_BEARER_TOKEN=...   # alternative auth if using JWT bearer tokens

# Deepgram (V3 transcription)
DEEPGRAM_API_KEY=...
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_DIARIZE_MODEL=latest
DEEPGRAM_MAX_SPEAKERS=6

# Replicate API for Whisper transcription (V1 API)
REPLICATE_API_TOKEN=

# Firebase service account (base64 encoded) - for Railway deployment
# Generate with: base64 -i service_account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Parallel processing workers (optional, legacy OpenAI rollback)
MAX_PREPARATION_WORKERS=5
MAX_CHUNK_WORKERS=10

# Legacy OpenAI path (kept for rollback; no longer used by V3)
# OPENAI_API_KEY=...
